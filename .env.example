# ─────────────────────────────────────────────────────────
#  NovaTech Support Chatbot — Environment Configuration
# ─────────────────────────────────────────────────────────
#
#  Copy this file to .env and fill in your values.
#  The server will run in DEMO MODE if GEMINI_API_KEY is
#  left blank — useful for local UI testing.
#
# ─────────────────────────────────────────────────────────

# Google Gemini API Key (get yours at https://aistudio.google.com)
GEMINI_API_KEY=

# Server port (default: 3000)
PORT=3000

# Comma-separated list of allowed CORS origins.
# Use * to allow all origins (not recommended for production).
# Example: https://yourshop.com,https://www.yourshop.com
ALLOWED_ORIGINS=*
